# Think4u production overlay for docker-jitsi-meet.
# Copy this to the AWS host as .env, generate the service passwords with
# ./gen-passwords.sh, and replace every placeholder. Never commit the real .env.
CONFIG=/opt/jitsi-config
PUBLIC_URL=https://meet.example.com
TZ=Asia/Kolkata
HTTP_PORT=80
HTTPS_PORT=443
JVB_ADVERTISE_IPS=YOUR_AWS_ELASTIC_IP
RESTART_POLICY=unless-stopped
JITSI_IMAGE_VERSION=stable-10532

# TLS and authenticated, token-only rooms.
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meet.example.com
LETSENCRYPT_EMAIL=security@example.com
ENABLE_HTTP_REDIRECT=1
ENABLE_HSTS=1
DISABLE_HTTPS=0
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
ENABLE_LOBBY=1
JWT_APP_ID=think4u
JWT_APP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SIGN_TYPE=HS256
JWT_ALLOW_EMPTY=0
JWT_ACCEPTED_ISSUERS=chat
JWT_ACCEPTED_AUDIENCES=jitsi

# Privacy-first room defaults. Enable only after an explicit policy and access
# control are in place for recordings/transcripts/third-party integrations.
ENABLE_RECORDING=0
ENABLE_FILE_RECORDING_SERVICE=0
ENABLE_FILE_RECORDING_SHARING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_VISITORS=0
ENABLE_BREAKOUT_ROOMS=0
ENABLE_END_CONFERENCE=1
ENABLE_AV_MODERATION=1
WHITEBOARD_COLLAB_SERVER_URL_BASE=
WHITEBOARD_COLLAB_SERVER_PUBLIC_URL=
DISABLE_LOCAL_RECORDING=1
DISABLE_PRIVATE_CHAT=1
DISABLE_GRANT_MODERATOR=1
DISABLE_KICKOUT=0
TOOLBAR_BUTTONS=microphone,camera,desktop,chat,raisehand,participants-pane,tileview,hangup,settings

# Generate distinct values with ./gen-passwords.sh; do not reuse passwords.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
